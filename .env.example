# Optional. No credentials are needed for the browser simulation.
# Enable the protected workflow API with a long random token (server only).
CRISIS_API_TOKEN=

# Vercel AI Gateway: select provider/model once agreed.
# Both values are required for AI planning; otherwise the workflow simulates it.
AI_GATEWAY_API_KEY=
AI_MODEL=

# Supabase project settings > API. Never expose the secret key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Reserved for the future HappyRobot adapter. Setting these does not enable calls.
HAPPYROBOT_API_KEY=
HAPPYROBOT_WORKFLOW_ID=
