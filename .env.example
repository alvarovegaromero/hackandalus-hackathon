# Copia este fichero a .env.local y rellena los valores reales ahi.
# .env.local esta ignorado por Git: nunca pongas credenciales en este fichero.

# ---------------------------------------------------------------------------
# Modo de ejecución
# ---------------------------------------------------------------------------
# mock       -> no sale nada del proceso, todo queda etiquetado como simulado.
# happyrobot -> ejecución real, y solo hacia contactos aprobados (demoSafe).
# Dejalo en mock salvo que tengas credenciales y destinatarios de demo
# aprobados para las acciones concretas que vas a lanzar.
ACTION_EXECUTION_MODE=mock

# ---------------------------------------------------------------------------
# Credenciales HappyRobot
# ---------------------------------------------------------------------------
# Sin las tres, el adaptador falla con un error explicito en vez de fingir.
HAPPYROBOT_API_KEY=
HAPPYROBOT_BASE_URL=https://api.happyrobot.ai
HAPPYROBOT_AGENT_ID=
# Opcional: id del workflow a disparar, si el contrato real lo pide.
HAPPYROBOT_WORKFLOW_ID=

# ---------------------------------------------------------------------------
# Contrato con HappyRobot (PENDIENTE DE CONFIRMAR)
# ---------------------------------------------------------------------------
# docs.happyrobot.ai esta restringido, así que la ruta y la forma del cuerpo
# NO están verificadas contra la documentación oficial (ver docs/happyDocumentation.md).
# Todo lo de abajo es configurable justamente para poder corregirlo el día de
# la demo sin tocar una linea de código.

# Ruta del endpoint de acción. Admite {agentId} y {workflowId}.
HAPPYROBOT_ACTION_PATH=/agents/{agentId}/actions
# Cabecera y esquema de autenticacion (deja el esquema vacio para mandar la
# clave a pelo, p. ej. si la API espera "x-api-key: <clave>").
HAPPYROBOT_AUTH_HEADER=authorization
HAPPYROBOT_AUTH_SCHEME=Bearer
# Cabecera de idempotencia. El valor enviado es action.idempotencyKey.
HAPPYROBOT_IDEMPOTENCY_HEADER=idempotency-key
# Forma del cuerpo: flat (campos en la raiz), wrapped ({"action": {...}}) o
# trigger ({"input": {...}, "idempotencyKey": "..."}).
HAPPYROBOT_PAYLOAD_SHAPE=flat
# Rutas, separadas por comas, donde buscar el id externo en la respuesta.
HAPPYROBOT_RESPONSE_ID_PATH=id,actionId,action_id,data.id
# Traduccion de canal local a canal HappyRobot, separada por comas.
HAPPYROBOT_CHANNEL_MAP=call=voice

# ---------------------------------------------------------------------------
# Robustez de la llamada saliente
# ---------------------------------------------------------------------------
# Tiempo máximo por intento: una llamada colgada no puede bloquear el centro
# de mando.
HAPPYROBOT_TIMEOUT_MS=8000
# Intentos totales por despacho. Solo se reintentan 5xx, red y timeout;
# un 4xx nunca se reintenta.
HAPPYROBOT_MAX_ATTEMPTS=3
# Base del backoff exponencial entre reintentos, en milisegundos.
HAPPYROBOT_RETRY_BASE_MS=400

# ---------------------------------------------------------------------------
# Webhook de entrada: POST /api/webhooks/happyrobot
# ---------------------------------------------------------------------------
# Secreto compartido que HappyRobot debe enviar en la cabecera
# x-happyrobot-secret. Si no esta definido, la ruta rechaza todo con 503:
# un webhook público sin secreto permitiria inyectar señales falsas.
HAPPYROBOT_WEBHOOK_SECRET=replace-with-a-shared-secret
