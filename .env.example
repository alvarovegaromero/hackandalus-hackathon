# Optional. No credentials are needed for the browser simulation.
# Public origin for landing metadata; Vercel's production origin is the fallback.
NEXT_PUBLIC_SITE_URL=
# Optional footer source-code link. Dashboard links always use /dashboard.
REPOSITORY_URL=

# Enable protected APIs with long random tokens (server only).
CRISIS_API_TOKEN=
DEMO_API_TOKEN=

# Command-center execution mode (root app/ and lib/).
# mock -> no external call leaves the process.
# happyrobot -> live execution, only toward approved demoSafe contacts.
ACTION_EXECUTION_MODE=mock

# P4 provider selection: gateway (default), opencode-go or opencode-zen.
# Planning always calls the configured model; its resource/communication tools are mock-only.
AI_PROVIDER=gateway
# Vercel AI Gateway configuration (used only with AI_PROVIDER=gateway).
AI_GATEWAY_API_KEY=
AI_MODEL=
# OpenCode configuration (server only). This adapter supports Luna Responses only.
# Go is designed for coding-agent traffic; confirm suitability before using it for crisis planning.
OPENCODE_API_KEY=
OPENCODE_MODEL=gpt-5.6-luna

# P2 Jev filter (server only). Missing key returns unavailable, never a fake decision.
# Provisional POC thresholds; calibrate on labeled examples before operational use.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_IRRELEVANT_MAX=0.2
JEV_RELEVANT_MIN=0.8
JEV_TIMEOUT_MS=8000

# Supabase project settings > API. Never expose the secret key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Server-side/CLI only. Copy direct and transaction-pooler URIs from Supabase
# Connect. Encode special characters in the password; never expose either URI.
SUPABASE_DIRECT_DB_URL=
SUPABASE_POOLER_DB_URL=

# Scenario panel -> agent bridge (/api/scenario/signals, no token). Always on in
# development; set to true to enable it in a production deployment.
SCENARIO_AGENT_ENABLED=

# HappyRobot credentials. Only used when ACTION_EXECUTION_MODE=happyrobot.
# Contract: POST {BASE_URL}/workflows/{workflowId}/runs (public SDK @happyrobot-ai/sdk).
# The hackathon workspace lives in the EU cluster; the US cluster is
# https://platform.happyrobot.ai/api/v2.
HAPPYROBOT_API_KEY=
HAPPYROBOT_BASE_URL=https://platform.eu.happyrobot.ai/api/v2
# Runs are created in this environment. Keep development/staging until the demo.
HAPPYROBOT_ENVIRONMENT=development
# Workflow ids or slugs. call -> dispatch, sms -> public-alert; other channels use the generic one.
HAPPYROBOT_DISPATCH_WORKFLOW_ID=
HAPPYROBOT_PUBLIC_ALERT_WORKFLOW_ID=
HAPPYROBOT_WORKFLOW_ID=
HAPPYROBOT_CHANNEL_WORKFLOWS=call=dispatch,sms=public-alert
# Stable incident id sent with every run.
CRISIS_INCIDENT_ID=faro-sierra-bermeja-demo

# Adapter knobs (defaults match the public SDK; change only if HappyRobot changes).
HAPPYROBOT_RUNS_PATH=/workflows/{workflowId}/runs
HAPPYROBOT_AUTH_HEADER=authorization
HAPPYROBOT_AUTH_SCHEME=Bearer
HAPPYROBOT_IDEMPOTENCY_HEADER=idempotency-key
HAPPYROBOT_RESPONSE_ID_PATH=run_id,id
HAPPYROBOT_TIMEOUT_MS=8000
HAPPYROBOT_MAX_ATTEMPTS=3
HAPPYROBOT_RETRY_BASE_MS=400
# Shared x-happyrobot-secret the FARO workflows send to POST /api/signals and POST /api/webhooks/happyrobot.
HAPPYROBOT_WEBHOOK_SECRET=replace-with-a-shared-secret

# Optional JSON persistence of the command-center state under .data/.
CRISIS_PERSISTENCE=
