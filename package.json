{
  "name": "butterfish",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "predev": "node scripts/clean-stray-app.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/clean-stray-app.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --reporter=dot",
    "prepare": "node scripts/install-hooks.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run secrets:check && npm run format:check && npm run lint && npm run typecheck && npm run build && npm run index:verify",
    "pr:check": "node scripts/guard-protected-branches.mjs commit && npm run check",
    "pr:create": "npm run pr:check && node scripts/create-pr.mjs",
    "lint:staged": "lint-staged --concurrent false",
    "secrets:check": "node scripts/check-secrets.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "graft": "graft",
    "index:build": "graft build",
    "index:map": "graft map",
    "index:check": "graft check",
    "index:verify": "npm run index:build && npm run index:check",
    "jev:try": "node --conditions=react-server scripts/try-jev.mjs",
    "mock:events": "node --env-file-if-exists=.env.local scripts/mock-events.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.106",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nanonets/graft": "0.10.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.8",
    "secretlint": "13.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
